{
  "name": "snippo-code-snippets",
  "displayName": "Snippo - Code Snippets",
  "description": "Save snippets in your web library, then search and insert them in VS Code.",
  "version": "1.1.2",
  "license": "MIT",
  "publisher": "dineshkaarthik",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.137.0"
  },
  "categories": [
    "Snippets",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "code-snippet-manager.showSnippets",
        "title": "Snippo: Show Snippets"
      },
      {
        "command": "code-snippet-manager.searchSnippets",
        "title": "Snippo: Search Snippets"
      },
      {
        "command": "code-snippet-manager.insertSnippet",
        "title": "Snippo: Insert Snippet"
      },
      {
        "command": "code-snippet-manager.saveSelectedCode",
        "title": "Snippo: Save Selected Code"
      },
      {
        "command": "code-snippet-manager.signIn",
        "title": "Snippo: Sign In"
      },
      {
        "command": "code-snippet-manager.signOut",
        "title": "Snippo: Sign Out"
      }
    ],
    "configuration": {
      "title": "Snippo",
      "properties": {
        "snippetManager.serverUrl": {
          "type": "string",
          "default": "https://snippet-manager-tan.vercel.app",
          "scope": "application",
          "description": "Origin of the Snippo server. Use HTTPS, or HTTP on loopback for local development."
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "code-snippet-manager.saveSelectedCode",
          "when": "editorHasSelection && !editorHasMultipleSelections",
          "group": "navigation@20"
        }
      ]
    },
    "keybindings": [
      {
        "command": "code-snippet-manager.showSnippets",
        "key": "ctrl+k ctrl+shift+1",
        "mac": "cmd+k ctrl+shift+1",
        "when": "editorTextFocus"
      },
      {
        "command": "code-snippet-manager.searchSnippets",
        "key": "ctrl+k ctrl+shift+2",
        "mac": "cmd+k ctrl+shift+2",
        "when": "editorTextFocus"
      },
      {
        "command": "code-snippet-manager.insertSnippet",
        "key": "ctrl+k ctrl+shift+3",
        "mac": "cmd+k ctrl+shift+3",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "command": "code-snippet-manager.saveSelectedCode",
        "key": "ctrl+k ctrl+shift+4",
        "mac": "cmd+k ctrl+shift+4",
        "when": "editorTextFocus && editorHasSelection && !editorHasMultipleSelections"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "node --test test/*.test.cjs",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "@types/vscode": "^1.137.0",
    "@vscode/vsce": "4.1.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "minimatch": "11.0.1",
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "extensionKind": [
    "ui"
  ],
  "keywords": [
    "snippets",
    "code snippets",
    "snippet manager",
    "sync"
  ],
  "homepage": "https://snippet-manager-tan.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/FunDood155/snippet_manager.git"
  },
  "bugs": {
    "url": "https://github.com/FunDood155/snippet_manager/issues"
  },
  "galleryBanner": {
    "color": "#007ACC",
    "theme": "dark"
  }
}
