{
  "name": "code-snippet-manager",
  "displayName": "Code Snippet Manager",
  "description": "A VS Code extension for managing and inserting code snippets using a Flask API.",
  "version": "0.0.1",
  "publisher": "code-snippet-manager",
  "engines": {
    "vscode": "^1.137.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "code-snippet-manager.showSnippets",
        "title": "Code Snippet Manager: Show Snippets"
      },
      {
        "command": "code-snippet-manager.searchSnippets",
        "title": "Code Snippet Manager: Search Snippets"
      },
      {
        "command": "code-snippet-manager.insertSnippet",
        "title": "Code Snippet Manager: Insert Snippet"
      },
      {
        "command": "code-snippet-manager.signIn",
        "title": "Code Snippet Manager: Sign In"
      },
      {
        "command": "code-snippet-manager.signOut",
        "title": "Code Snippet Manager: Sign Out"
      }
    ],
    "configuration": {
      "title": "Code Snippet Manager",
      "properties": {
        "snippetManager.serverUrl": {
          "type": "string",
          "default": "https://snippet-manager-tan.vercel.app",
          "scope": "application",
          "description": "Origin of the Code Snippet Manager server. Use HTTPS, or HTTP on loopback for local development."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "node --test test/*.test.cjs",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "@types/vscode": "^1.137.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "extensionKind": [
    "ui"
  ]
}
